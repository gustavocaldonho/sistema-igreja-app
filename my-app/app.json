{
  "expo": {
    "name": "e-Igreja",
    "slug": "my-app",
    "version": "1.0.17",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#cccccc"
    },
    "notification": {
      "icon": "./assets/icon-notification.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/icon-ios.png",
      "supportsTablet": true,
      "buildNumber": "5",
      "bundleIdentifier": "com.gcaldonho.myapp",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "O aplicativo e-Igreja permite que você selecione uma foto da sua galeria para usá-la como imagem de perfil na sua conta.",
        "NSUserTrackingUsageDescription": "Este aplicativo deseja enviar notificações para manter você informado.",
        "UIBackgroundModes": ["fetch", "remote-notification"],
        "FirebaseAppDelegateProxyEnabled": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo e-Igreja permite que você selecione uma foto da sua galeria para usá-la como imagem de perfil na sua conta."
        }
      ],
      "expo-font",
      "./plugins/with-modular-firebase",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon-notification.png"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "android": {
      "package": "com.gcaldonho.myapp",
      "versionCode": 17,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "20d6e717-1aea-4c22-a0b0-756bb3f05867"
      }
    },
    "owner": "gcaldonho"
  }
}
