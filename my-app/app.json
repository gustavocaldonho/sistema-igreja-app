{
  "expo": {
    "name": "e-Igreja",
    "slug": "my-app",
    "version": "1.0.13",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ccc"
    },
    "notification": {
      "icon": "./assets/icon-notification.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gcaldonho.myapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "O aplicativo e-Igreja permite que você selecione uma foto da sua galeria para usá-la como imagem de perfil na sua conta."
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo e-Igreja permite que você selecione uma foto da sua galeria para usá-la como imagem de perfil na sua conta."
        }
      ],
      "expo-font"
    ],
    "android": {
      "package": "com.gcaldonho.myapp",
      "versionCode": 13,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "20d6e717-1aea-4c22-a0b0-756bb3f05867"
      }
    },
    "owner": "gcaldonho"
  }
}
